# Airflow (standalone: scheduler + webserver + triggerer, SequentialExecutor)
# plus a JRE and the pyspark wheel so the batch DAG's spark-submit task runs
# Spark in local mode inside this container.
# Mini-project simplification: production Airflow would submit to an external
# Spark cluster (SparkSubmitOperator / Kubernetes) instead.
FROM apache/airflow:2.9.1-python3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps \
    && rm -rf /var/lib/apt/lists/*

USER airflow
COPY requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir "apache-airflow==2.9.1" -r /tmp/requirements-airflow.txt

WORKDIR /app
COPY --chown=airflow:root . /app
ENV PYTHONPATH=/app
