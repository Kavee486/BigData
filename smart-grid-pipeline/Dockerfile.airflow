# Airflow (standalone/SequentialExecutor, per the assignment's "manage batch
# jobs" requirement) with a JVM + pyspark bundled so the batch DAG's
# spark-submit BashOperator can run locally inside this same container.
# NOTE: this is a mini-project simplification -- production Airflow would
# submit to an external Spark cluster rather than run Spark in-process.
FROM apache/airflow:2.9.1-python3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

USER airflow
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

WORKDIR /app
COPY . /app
ENV PYTHONPATH=/app
