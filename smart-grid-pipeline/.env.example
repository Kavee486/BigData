# Copy to .env to override defaults used by docker-compose.yml
SIMULATED_DAY_SECONDS=300
METER_EMIT_INTERVAL_SECONDS=2
NUM_HOUSEHOLDS=24
DIRTY_EVENT_RATE=0.01
LOW_RENEWABLE_PCT_THRESHOLD=10
NO_DATA_ALERT_MINUTES=2
INVALID_EVENT_RATE_THRESHOLD_PCT=5
STREAM_LAG_THRESHOLD_SECONDS=60
RECONCILIATION_DRIFT_THRESHOLD_PCT=10
# Optional: Slack/Teams-compatible incoming webhook for alert notifications
ALERT_WEBHOOK_URL=
POSTGRES_HOST_PORT=5433
